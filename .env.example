# ------------------------------------------------------------
# Everything here is OPTIONAL. The app works with NO env vars.
# ------------------------------------------------------------

# Overpass API endpoint. Default is the free public server.
# Leave unset unless you have a reason to use another server.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Your email or website. Sent in the User-Agent header so the Overpass
# operators can contact you if your traffic causes a problem. Recommended.
OVERPASS_CONTACT=you@example.com

# --- Optional cloud lead storage (Supabase free tier, no card needed) ---
# Without these, leads are saved on your own phone/browser only.
# Server-side only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A passcode you invent. You type it once in the app's Settings tab.
ADMIN_PASSCODE=
